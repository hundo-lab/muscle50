{
  "title": "telegram_llm_interpret_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "photo_kind",
    "meal_type",
    "date_expression",
    "tense",
    "items",
    "question_topics",
    "menu",
    "refers_to",
    "edit",
    "reply",
    "memory_summary"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "meal_log",
        "question",
        "menu",
        "menu_suggest",
        "meal_edit",
        "chat",
        "sync_request",
        "unclear"
      ]
    },
    "photo_kind": {
      "type": "string",
      "enum": [
        "meal_photo",
        "menu_capture",
        "unclear",
        "none"
      ]
    },
    "meal_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "breakfast",
        "lunch",
        "dinner",
        "snack",
        "other",
        null
      ]
    },
    "date_expression": {
      "type": "string",
      "enum": [
        "none",
        "today",
        "yesterday",
        "other"
      ]
    },
    "tense": {
      "type": "string",
      "enum": [
        "eaten",
        "planned",
        "none"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "food_text",
          "quantity",
          "unit",
          "quantity_estimated",
          "memo",
          "estimate",
          "meal_type",
          "food_id",
          "source",
          "assumption",
          "from_label",
          "portions",
          "menu_ref",
          "join_existing",
          "lookup_wanted"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "catalog",
              "general"
            ]
          },
          "food_text": {
            "type": "string",
            "description": "the food words exactly as the user wrote them"
          },
          "quantity": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "g",
              "ml",
              "count",
              "pack",
              "piece",
              "animal",
              "serving",
              null
            ]
          },
          "quantity_estimated": {
            "type": "boolean"
          },
          "memo": {
            "type": [
              "string",
              "null"
            ]
          },
          "estimate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kcal_min",
              "kcal_max",
              "protein_min",
              "protein_max",
              "carbs_min",
              "carbs_max",
              "fat_min",
              "fat_max"
            ],
            "properties": {
              "kcal_min": {
                "type": "number"
              },
              "kcal_max": {
                "type": "number"
              },
              "protein_min": {
                "type": "number"
              },
              "protein_max": {
                "type": "number"
              },
              "carbs_min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "carbs_max": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "fat_min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "fat_max": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "description": "estimated ranges for the whole dish or meal; kcal and protein are required, carbs and fat are null when not estimated"
          },
          "meal_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "breakfast",
              "lunch",
              "dinner",
              "snack",
              "other",
              null
            ],
            "description": "the meal this food belongs to when the user named meals; null otherwise"
          },
          "food_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "the catalog ID of this food when it is in the catalog list; otherwise null"
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "description": "site name only (no URL) when a web search was used; otherwise null"
          },
          "assumption": {
            "type": [
              "string",
              "null"
            ],
            "description": "what was assumed for the estimate, without numbers; otherwise null"
          },
          "from_label": {
            "type": "boolean",
            "description": "true when the values are printed on a nutrition label (photo or the user's words)"
          },
          "portions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "g_min",
                "g_max"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "g_min": {
                  "type": "number"
                },
                "g_max": {
                  "type": "number"
                }
              }
            },
            "description": "the grams assumed per component (at most 4) when the user did not say the amount; an empty array otherwise"
          },
          "menu_ref": {
            "type": [
              "integer",
              "null"
            ],
            "description": "the number of the listed recent menu item the user says they ate; otherwise null"
          },
          "join_existing": {
            "type": "boolean",
            "description": "true when the user asks to add this food to the meal of that type already recorded that day"
          },
          "lookup_wanted": {
            "type": "boolean",
            "description": "true only for a named brand, restaurant, chain or packaged product whose nutrition a web lookup would materially change"
          }
        }
      }
    },
    "question_topics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "training",
          "nutrition",
          "body",
          "bot"
        ]
      }
    },
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slots_visible",
        "items"
      ],
      "properties": {
        "slots_visible": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "breakfast",
              "lunch",
              "dinner"
            ]
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "corner",
              "name",
              "printed_kcal",
              "printed_protein_g",
              "estimate"
            ],
            "properties": {
              "slot": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "breakfast",
                  "lunch",
                  "dinner",
                  null
                ]
              },
              "corner": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              },
              "printed_kcal": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "printed_protein_g": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "estimate": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kcal_min",
                  "kcal_max",
                  "protein_min",
                  "protein_max",
                  "carbs_min",
                  "carbs_max",
                  "fat_min",
                  "fat_max"
                ],
                "properties": {
                  "kcal_min": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "kcal_max": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "protein_min": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "protein_max": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "carbs_min": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "carbs_max": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "fat_min": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "fat_max": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "description": "estimated ranges for the whole dish or meal; null when not estimated"
              }
            }
          }
        }
      }
    },
    "refers_to": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "open_proposal",
        "last_recorded",
        null
      ],
      "description": "open_proposal: the message corrects the proposal that is still open (meal_log with the whole corrected meal); last_recorded: it corrects a meal that was just recorded (meal_edit); null: it stands on its own"
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "target_food_text",
        "new_food_text",
        "new_quantity",
        "new_unit",
        "new_meal_type",
        "new_memo",
        "estimate",
        "from_label",
        "target_meal_ordinal"
      ],
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "change_quantity",
            "replace_food",
            "remove_item",
            "add_item",
            "void_meal",
            "change_meal_type",
            "change_estimate",
            null
          ]
        },
        "target_food_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "new_food_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "new_quantity": {
          "type": [
            "number",
            "null"
          ]
        },
        "new_unit": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "g",
            "ml",
            "count",
            "pack",
            "piece",
            "animal",
            "serving",
            null
          ]
        },
        "new_meal_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "breakfast",
            "lunch",
            "dinner",
            "snack",
            "other",
            null
          ]
        },
        "new_memo": {
          "type": [
            "string",
            "null"
          ]
        },
        "estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kcal_min",
            "kcal_max",
            "protein_min",
            "protein_max",
            "carbs_min",
            "carbs_max",
            "fat_min",
            "fat_max"
          ],
          "properties": {
            "kcal_min": {
              "type": [
                "number",
                "null"
              ]
            },
            "kcal_max": {
              "type": [
                "number",
                "null"
              ]
            },
            "protein_min": {
              "type": [
                "number",
                "null"
              ]
            },
            "protein_max": {
              "type": [
                "number",
                "null"
              ]
            },
            "carbs_min": {
              "type": [
                "number",
                "null"
              ]
            },
            "carbs_max": {
              "type": [
                "number",
                "null"
              ]
            },
            "fat_min": {
              "type": [
                "number",
                "null"
              ]
            },
            "fat_max": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "description": "only the nutrients that change (min and max together); null for the others"
        },
        "from_label": {
          "type": "boolean",
          "description": "true when the new estimate is printed on a nutrition label"
        },
        "target_meal_ordinal": {
          "type": [
            "integer",
            "null"
          ],
          "description": "the Nth meal of target meal_type that day (아침 1식 is 1); otherwise null"
        }
      }
    },
    "reply": {
      "type": [
        "string",
        "null"
      ]
    },
    "memory_summary": {
      "type": "string"
    }
  }
}
